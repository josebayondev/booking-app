# Plantilla de configuración local: copia este fichero a .env y ajusta lo que necesites.
# .env está en .gitignore; los entornos desplegados inyectan estas variables por entorno.
ENVIRONMENT=local
PROJECT_NAME="Booking App API"
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/booking_app
# Déjalo vacío para desactivar Sentry. Solo los entornos desplegados lo definen.
SENTRY_DSN=
# La zona horaria del dueño, usada para leer las reglas de disponibilidad. Las reservas se
# guardan en UTC.
BOOKING_TIMEZONE=Europe/Madrid
