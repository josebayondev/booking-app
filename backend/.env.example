# Plantilla de configuración local: copia este fichero a .env y ajusta lo que necesites.
# .env está en .gitignore; los entornos desplegados inyectan estas variables por entorno.
ENVIRONMENT=local
PROJECT_NAME="Booking App API"
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/booking_app
# Déjalo vacío para desactivar Sentry. Solo los entornos desplegados lo definen.
SENTRY_DSN=
# La zona horaria del dueño, usada para leer las reglas de disponibilidad. Las reservas se
# guardan en UTC.
BOOKING_TIMEZONE=Europe/Madrid
# Rate limiting de /api/v1: peticiones permitidas por cliente y por ventana. /health queda
# fuera -- lo consultan las sondas de uptime.
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
# Login del panel de administración (FEAT 14): un único rol, identidad por variables de
# entorno -- no hay tabla de usuarios (mismo razonamiento que BOOKING_TIMEZONE). Vacío
# aquí porque no hay ningún hash de ejemplo que compartir: genera el tuyo con
#   uv run python -c "import bcrypt; print(bcrypt.hashpw(b'tu-contraseña', bcrypt.gensalt()).decode())"
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# Secreto de firma del JWT (HS256). El valor de abajo es solo para desarrollo local -- este
# es un repositorio público, así que cualquier entorno desplegado define el suyo propio y
# nunca reutiliza este.
JWT_SECRET=dev-only-secret-change-me-please-32-bytes
# 24 horas, sin refresh token.
JWT_EXPIRES_MINUTES=1440
