ENVIRONMENT=local
PROJECT_NAME="Booking App API"
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/booking_app
# Leave empty to disable Sentry. Only the deployed environments set it.
SENTRY_DSN=
# The owner's timezone, used to read availability rules. Bookings are stored in UTC.
BOOKING_TIMEZONE=Europe/Madrid
