# Qué se queda fuera del repositorio. Ojo con la sección de variables de entorno:
# .env está ignorado y .env.example es la única excepción que sí se commitea.
# ==============================================================
# Python / Backend
# ==============================================================
__pycache__/
*.py[codz]
*.so
build/
dist/
backend/lib/
backend/lib64/
*.egg-info/
*.egg

# Tests / cobertura
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.hypothesis/

# Logs y DB local
*.log
db.sqlite3
db.sqlite3-journal

# mypy / ruff
.mypy_cache/
.ruff_cache/

# ==============================================================
# Node / Frontend
# ==============================================================
node_modules/
dist/
dist-ssr/
.vite/
*.local
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache
*.tsbuildinfo

